  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^16.5.0",
    "knip": "^5.36.0",
    "typescript": "^5",
    "typescript-eslint": "^8.56.0"
  },
  "knip": {
    "ignore": [
      "public/**",
      "Unity/**"
